{
    "name":  "dsh-docs-mode",
    "version":  "2.1.3",
    "description":  "文书模式（docs-mode）：技术文档撰写 Agent preset。覆盖 11+ 类技术文书，含模板知识库、去 AI 味与质量保障工具集。随包携带三个技能与模板/工具脚本，装完即用。",
    "type":  "module",
    "license":  "MIT",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "cordis.patch.yml",
                  "skills",
                  "assets",
                  "tools",
                  "preset",
                  "README.md",
                  "LICENSE"
              ],
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "dsh-bundle",
                     "preset",
                     "docs",
                     "documentation",
                     "技术文档",
                     "文书"
                 ],
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/zh851233/docs-mode.git"
                   },
    "engines":  {
                    "node":  "\u003e=22"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           }
            }
}
